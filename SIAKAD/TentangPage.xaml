<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SIAKAD.TentangPage"
    Title="Tentang">
    <ScrollView>
        <StackLayout Padding="18" Spacing="20">
            <Frame
                Padding="0"
                CornerRadius="12"
                HasShadow="True"
                Margin="0"
                HeightRequest="200"
                >
                <Grid>
                    <Image
                        Source="bg"
                        Aspect="AspectFill" />

                    <StackLayout
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="CenterAndExpand"
                        Spacing="5">

                        <Image
                            Source="logo"
                            HeightRequest="80"
                            WidthRequest="80"
                            HorizontalOptions="Center" />

                        <Label
                            Text="Teknik Informatika"
                            HorizontalOptions="Center"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            Text="Universitas Karyadarma Kupang"
                            HorizontalOptions="Center"
                            TextColor="#D9ECFF"
                            FontSize="12" />
                    </StackLayout>
                </Grid>
            </Frame>

            <Frame
                BackgroundColor="White"
                BorderColor="DarkGray"
                CornerRadius="12"
                Padding="18"
                HasShadow="True">
                <StackLayout Spacing="15">
                    <Frame
                        Padding="0"
                        CornerRadius="5"
                        IsClippedToBounds="True"
                        BackgroundColor="White"
                        HasShadow="False">
                        <Image
                            Source="danar"
                            Aspect="AspectFit"
                            VerticalOptions="Start"/>
                    </Frame>

                    <Label
                        Text="2302090001"
                        HorizontalOptions="Center"
                        TextColor="Black"
                        FontSize="24"
                        FontAttributes="Bold"/>

                    <BoxView 
                        HeightRequest="2"
                        WidthRequest="260"
                        Color="DarkGray"
                        HorizontalOptions="Center"
                        Margin="0, 10, 0, 10"/>

                    <StackLayout 
                        Orientation="Horizontal" Spacing="10" Padding="12,8">
                        <Label
                            Text="Nama:"
                            TextColor="Black"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Label
                            Text="Danar A. Dida"
                            TextColor="Black"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </StackLayout>

                    <StackLayout 
                        Orientation="Horizontal" Spacing="10" Padding="12,8">
                        <Label
                            Text="No Telp:"
                            TextColor="Black"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Label
                            Text="081338866300"
                            TextColor="Black"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </StackLayout>

                    <StackLayout 
                        Orientation="Horizontal" Spacing="10" Padding="12,8">
                        <Label
                            Text="Alamat:"
                            TextColor="Black"
                            FontSize="24"
                            VerticalOptions="Center" />

                        <Label
                            Text="NBD"
                            TextColor="Black"
                            FontSize="24"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </StackLayout>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>