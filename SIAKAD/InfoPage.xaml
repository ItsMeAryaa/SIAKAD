<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SIAKAD.InfoPage"
    Title="Info">
    <StackLayout Padding="18" Spacing="20">
        <Frame
            Padding="0"
            CornerRadius="12"
            HasShadow="True"
            Margin="0"
            HeightRequest="200"
            >
            <Grid>
                <Image
                    Source="bg"
                    Aspect="AspectFill" />

                <StackLayout
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    Spacing="5">

                    <Image
                        Source="logo"
                        HeightRequest="80"
                        WidthRequest="80"
                        HorizontalOptions="Center" />

                    <Label
                        Text="SIAKAD (Sistem Informasi Akademik)"
                        HorizontalOptions="CenterAndExpand"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <Label
                        Text="Teknik Informatika"
                        HorizontalOptions="CenterAndExpand"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <Label
                        Text="V1.0"
                        HorizontalOptions="Center"
                        TextColor="#D9ECFF"
                        FontSize="12" />
                </StackLayout>
            </Grid>
        </Frame>
    </StackLayout>
</ContentPage>