<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SIAKAD.DetailMahasiswaPage"
    Title="Detail Mahasiswa">
    
    <ScrollView>
        <StackLayout Padding="18" Spacing="20">

            <Frame
                Padding="0"
                CornerRadius="12"
                HasShadow="True"
                Margin="0"
                HeightRequest="200"
                >
                <Grid>
                    <Image
                        Source="bg"
                        Aspect="AspectFill" />

                    <StackLayout
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="CenterAndExpand"
                        Spacing="5">
                        <Frame
                            WidthRequest="100"
                            HeightRequest="100"
                            IsClippedToBounds="True"
                            BackgroundColor="White"
                            BorderColor="Cyan"
                            HorizontalOptions="Center"
                            CornerRadius="780"
                            Padding="0"
                            HasShadow="True">

                            <Image
                                x:Name="imgMahasiswa"
                                Aspect="AspectFill" />

                        </Frame>

                        <Label
                            x:Name="lbNama"
                            TextColor="White"
                            FontSize="Medium"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <StackLayout Orientation="Horizontal">
                            <Label
                                x:Name="lbProdi"
                                TextColor="White"
                                FontSize="Small"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="|"
                                TextColor="White"
                                FontSize="Small"
                                HorizontalTextAlignment="Center" />

                            <Label
                                x:Name="lbNim"
                                TextColor="White"
                                FontSize="Small"
                                HorizontalTextAlignment="Center" />
                        </StackLayout>

                    </StackLayout>
                </Grid>
            </Frame>

            <Frame
                BackgroundColor="White"
                BorderColor="Gray"
                CornerRadius="12"
                Padding="18"
                HasShadow="True">
                <StackLayout Spacing="15">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label
                            Text="No Telp:"
                            TextColor="Black"
                            FontSize="14"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="lbTelp"
                            TextColor="Black"
                            FontSize="14"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label
                            Text="Alamat:"
                            TextColor="Black"
                            FontSize="14"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="lbAlamat"
                            TextColor="Black"
                            FontSize="14"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />
                    </StackLayout>
                </StackLayout>
            </Frame>
            
        </StackLayout>
    </ScrollView>

</ContentPage>