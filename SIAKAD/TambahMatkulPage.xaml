<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SIAKAD.TambahMatkulPage"
    Title="Tambah Data Mata Kuliah">

    <StackLayout Padding="20">
        <Frame 
            Padding="10"
            BorderColor="Gray"
            CornerRadius="8"
            HasShadow="False">

            <Entry
                x:Name="txtKode"
                Placeholder="Kode Matkul"
                PlaceholderColor="Gray"
                TextColor="Black" />

        </Frame>

        <Frame 
            Padding="10"
            BorderColor="Gray"
            CornerRadius="8"
            HasShadow="False">

            <Entry
                x:Name="txtNama"
                Placeholder="Nama Matkul"
                PlaceholderColor="Gray"
                TextColor="Black" />

        </Frame>

        <Frame 
            Padding="10"
            BorderColor="Gray"
            CornerRadius="8"
            HasShadow="False">

            <Entry
                x:Name="txtSks"
                Placeholder="SKS"
                PlaceholderColor="Gray"
                TextColor="Black" />

        </Frame>

        <Button
            x:Name="btnSimpan"
            Text="Simpan"
            BackgroundColor="Cyan"
            TextColor="White"
            Clicked="BtnSimpan" />
    </StackLayout>

</ContentPage>